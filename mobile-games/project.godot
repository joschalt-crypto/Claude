; Godot project for small mobile (portrait) games.
; Edit with the Godot 4.3+ editor, or run headless via tools/get_godot.sh

config_version=5

[application]

config/name="Mini Games"
config/description="A small collection of one-hand portrait mini games."
run/main_scene="res://scenes/MainMenu.tscn"
config/features=PackedStringArray("4.3", "Mobile")
config/icon="res://icon.svg"

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/handheld/orientation=1
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[input_devices]

pointing/emulate_touch_from_mouse=true

[rendering]

renderer/rendering_method="mobile"
